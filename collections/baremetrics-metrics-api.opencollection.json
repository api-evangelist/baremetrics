{
  "opencollection": "1.0.0",
  "info": {
    "name": "Baremetrics Annotations Metrics API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Metrics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Show Metric",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.baremetrics.com/v1/metrics/:metric",
            "params": [
              {
                "name": "metric",
                "value": "",
                "type": "path"
              },
              {
                "name": "start_date",
                "value": "",
                "type": "query",
                "description": "Start date in YYYY-MM-DD format."
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query",
                "description": "End date in YYYY-MM-DD format."
              }
            ]
          },
          "docs": "Returns a single metric summary (e.g. mrr, arr, ltv, customers, arpu, asp, customer_churn_rate, mrr_churn_rate, ltv, avg_sub_length)."
        }
      ]
    }
  ],
  "bundled": true
}