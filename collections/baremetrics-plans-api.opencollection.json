{
  "opencollection": "1.0.0",
  "info": {
    "name": "Baremetrics Annotations Plans API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Plans",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Plans",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.baremetrics.com/v1/:source_id/plans",
            "params": [
              {
                "name": "source_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns a list of plans for a given source."
        },
        {
          "info": {
            "name": "Show Plan",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.baremetrics.com/v1/:source_id/plans/:oid",
            "params": [
              {
                "name": "source_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "oid",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns a single plan by its OID."
        }
      ]
    }
  ],
  "bundled": true
}